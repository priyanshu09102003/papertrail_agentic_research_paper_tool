# =============================================================================
# PaperTrail Root .gitignore (Backend & Frontend)
# =============================================================================

# Python Virtual Environments
.venv/
venv/
env/
ENV/

# Python Bytecode, Caches & Test Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Application Local Caches, Databases & Managed Storage
.cache/
data/
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-shm
*.db-wal

# Node.js & Next.js (Frontend)
node_modules/
.next/
out/
.vercel/
next-env.d.ts
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment Variables & Secrets (Never commit secrets)
.env
.env.*
!.env.example

# OS & Editor Files
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
