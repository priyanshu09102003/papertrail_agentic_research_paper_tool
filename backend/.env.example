# =============================================================================
# PaperTrail Backend Environment Configuration (Copy to .env)
# Never commit your real .env file to Git!
# =============================================================================

# Optional: Google Gemini API Key for fast (2-4s) structured scientific extraction.
# Get a free API key at: https://aistudio.google.com/app/apikey
# If left empty, PaperTrail automatically falls back to local Ollama (qwen2.5:1.5b).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local Ollama Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
